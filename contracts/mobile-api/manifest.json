      "errorFixtures": ["fixtures/errors/unauthenticated.json", "fixtures/errors/insight-not-found.json", "fixtures/errors/coach-error.json"],
      "notes": ["This network path is dormant while USE_MOCK_PLAYER_DATA is true.", "training may be empty."]
    },
    {
      "id": "coach.training.get",
      "method": "GET",
      "pathTemplate": "/api/coach/training",
      "routeFile": "src/app/api/coach/training/route.ts",
      "authMode": "session-or-bearer",
      "mobileConsumers": ["playtt-mobile/lib/coach-api.ts", "playtt-mobile/components/coach/coach-training-panel.tsx"],
