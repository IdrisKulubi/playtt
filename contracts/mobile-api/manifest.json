    {
      "kind": "mobile-consumer-without-producer",
      "method": "POST",
      "pathTemplate": "/api/coach/chat",
      "mobileConsumer": "playtt-mobile/lib/coach-chat-api.ts",
      "note": "The mobile call is dormant while USE_MOCK_PLAYER_DATA is true, and no src/app/api/coach/chat/route.ts exists."
