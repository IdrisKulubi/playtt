      "mobileConsumers": ["playtt-mobile/lib/coach-api.ts", "playtt-mobile/components/coach/coach-subscribe-sheet.tsx"],
      "successFixture": "fixtures/coach.subscribe.post.success.json",
      "errorFixtures": ["fixtures/errors/unauthenticated.json", "fixtures/errors/payment-error.json", "fixtures/errors/coach-error.json"],
      "notes": ["The subscription UI is preview-only while USE_MOCK_PLAYER_DATA is true.", "authorizationUrl is optional in the producer type."]
    },
    {
      "id": "coach.cancel.post",
