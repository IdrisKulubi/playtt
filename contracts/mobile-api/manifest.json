  ],
  "producerConsumerDrift": [
    {
      "kind": "producer-without-mobile-consumer",
      "method": "POST",
      "pathTemplate": "/api/replays/request",
      "routeFile": "src/app/api/replays/request/route.ts",
      "note": "The producer exists, but no current playtt-mobile source calls this endpoint; it is intentionally excluded from endpoints."
    },
    {
      "kind": "producer-without-mobile-consumer",
      "method": "GET",
      "pathTemplate": "/api/replays/mine",
      "routeFile": "src/app/api/replays/mine/route.ts",
      "note": "The producer exists, but Activity currently renders mock replay data and no current mobile source calls this endpoint; it is intentionally excluded from endpoints."
