{
  "expo": {
    "name": "playtt",
    "slug": "playtt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/playtt-logo.png",
    "scheme": "playtt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.theplaytt.app",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07111d",
        "foregroundImage": "./assets/images/playtt-logo.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/playtt-logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/playtt-logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#07111d",
          "dark": {
            "backgroundColor": "#07111d"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e63648ed-3c85-46ca-bb59-23f0177de455"
      }
    }
  }
}
