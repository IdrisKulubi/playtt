{
  "expo": {
    "name": "playtt",
    "slug": "playtt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/appstore.png",
    "scheme": "playtt",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "icon": "./assets/images/appstore.png",
      "bundleIdentifier": "com.theplaytt.app",
      "usesAppleSignIn": true,
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryAddUsageDescription": "PlayTT saves your session clips and activity cards to your photo library when you choose Save."
      }
    },
    "android": {
      "icon": "./assets/images/playstore.png",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/playstore-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/mark.png"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#07111d",
          "dark": {
            "backgroundColor": "#07111d"
          }
        }
      ],
      "expo-video",
      [
        "expo-media-library",
        {
          "photosPermission": "PlayTT can access your photos to save session clips and activity cards.",
          "savePhotosPermission": "PlayTT saves your session clips and activity cards to your photo library when you choose Save.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e63648ed-3c85-46ca-bb59-23f0177de455"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e63648ed-3c85-46ca-bb59-23f0177de455"
    }
  }
}
