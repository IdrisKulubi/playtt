{
  "cli": {
    "version": ">= 24.4.1",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://www.theplaytt.com"
      },
      "channel": "production"
    }
  },
  "submit": {
    "production": {}
  }
}
