# Base URL of the PlayTT web/API backend (Better Auth lives at /api/auth)
EXPO_PUBLIC_API_URL=https://www.theplaytt.com

# Local development (requires pnpm dev at repo root):
# EXPO_PUBLIC_API_URL=http://localhost:3000

# Physical device on the same network (simulator can use localhost):
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Highlights tab loads live clips from /api/replays/mine by default.
# Set to false to use sample mock clips during development.
# EXPO_PUBLIC_LIVE_REPLAY_LIBRARY=false
