{
  "name": "playtt",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "next dev",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "node --env-file=.env.local scripts/run-seed-phase1.mjs",
    "db:validate": "node scripts/validate-migrations.mjs",
    "db:validate:strict": "node scripts/validate-migrations.mjs --strict",
    "db:replay-lineage": "node scripts/replay-drizzle-lineage.mjs",
    "db:build-snapshots": "node scripts/build-migration-snapshots.mjs",
    "test:db": "node --test scripts/validate-migrations.test.mjs scripts/disposable-postgres.test.mjs src/server/bookings/database-errors.test.mjs",
    "test:db:integration": "node --test --test-concurrency=1 scripts/integration/phase0-concurrency.test.mjs scripts/integration/phase2-clone-migration.test.mjs scripts/integration/phase2-durable.test.mjs",
    "test:http": "node --test src/lib/public-version.test.mjs src/lib/trusted-auth-origins.test.mjs src/lib/web-cors-origins.test.mjs src/server/http/error-mapping.test.mjs src/server/users/serialization.test.mjs",
    "test:payments": "node --test src/server/payments/webhook-processor.test.mjs src/server/payments/webhook-inbox.test.mjs src/server/payments/confirm-booking.test.mjs src/server/payments/confirmation-email-consumer.test.mjs",
    "test:workers": "node --test src/server/workers/durable-work.test.mjs",
    "test:replays": "node --test src/server/replays/ready-callback.test.mjs src/server/replays/stub-policy.test.mjs",
    "test:actions": "node --test src/actions/create-pending-booking-coordinator.test.mjs src/server/bookings/ownership-coordinator.test.mjs",
    "test:contracts": "node --test scripts/validate-api-contracts.test.mjs scripts/validate-web-actions.test.mjs && node scripts/validate-api-contracts.mjs && node scripts/validate-web-actions.mjs",
    "test:compatibility": "node --test src/lib/compatibility/status-labels.test.mjs src/lib/compatibility/replay-status.test.mjs",
    "test:tenancy": "node --test src/server/tenancy/permissions.test.mjs src/server/tenancy/tenancy-seed.test.mjs src/server/tenancy/authorize-context.test.mjs src/server/tenancy/audit-log.test.mjs",
    "test:catalog": "node --test src/server/catalog/catalog-seed.test.mjs src/server/catalog/map-venue.test.mjs src/server/catalog/catalog-capabilities.test.mjs src/server/catalog/public-venues.test.mjs",
    "test:access-points": "node --test src/server/catalog/access-points.test.mjs",
    "test:sessions": "node --test src/server/sessions/sessions.test.mjs src/server/sessions/lifecycle.test.mjs",
    "test:tenant-backfill": "node --test db/backfill-tenant-scope.test.mjs scripts/validate-tenant-backfill.test.mjs",
    "test:tenant-rbac": "node --test src/server/bookings/tenant-rbac.test.mjs",
    "test:operator": "node --test src/server/operator/operator-access.test.mjs src/server/operator/operator-rbac.test.mjs src/server/operator/operator-durable-work.test.mjs",
    "test:devices": "node --test src/server/devices/policies.test.mjs src/server/devices/devices.test.mjs",
    "test:scoring": "node --test src/server/scoring/tt-standard-v1.test.mjs src/server/scoring/scoring-ingest.test.mjs",
    "test:realtime": "node --test src/server/realtime/broadcaster.test.mjs src/server/realtime/display.test.mjs",
    "test:secret-scan": "node scripts/secret-scan.mjs",
    "e2e:seed-user": "node scripts/e2e/seed-test-user.mjs",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.3.0",
    "@better-auth/expo": "^1.6.14",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@neondatabase/serverless": "^1.0.2",
    "@next/env": "^16.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-email/components": "^1.0.11",
    "better-auth": "^1.6.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "gsap": "^3.15.0",
    "input-otp": "^1.4.2",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "pg": "^8.20.0",
    "postgres": "^3.4.9",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-day-picker": "^9.14.0",
    "react-dom": "^19.2.4",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "3.8.0",
    "resend": "^6.10.0",
    "shadcn": "^4.1.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "@playwright/test": "^1.55.0",
    "jose": "^6.2.3",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "overrides": {
      "kysely": "0.28.17"
    }
  }
}
